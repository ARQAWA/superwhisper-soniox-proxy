<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/dist/src/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WS_MODE</key>
    <string>soniox</string>
    <key>DRY_RUN</key>
    <string>false</string>
    <key>LOG_LEVEL</key>
    <string>info</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SONIOX_ENDPOINT_DETECTION</key>
    <string>true</string>
    <key>SONIOX_AUTO_LANGUAGE</key>
    <string>hi</string>
    <key>SONIOX_ENDPOINT_LATENCY_ADJUSTMENT_LEVEL</key>
    <string>0</string>
    <key>SONIOX_ENDPOINT_SENSITIVITY</key>
    <string>-1</string>
    <key>SONIOX_MAX_ENDPOINT_DELAY_MS</key>
    <string>3000</string>
    <key>SCRIBE_VERBATIM</key>
    <string>true</string>
    <key>SCRIBE_VAD_SILENCE_THRESHOLD_SECS</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/proxy.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/proxy.stderr.log</string>
</dict>
</plist>
